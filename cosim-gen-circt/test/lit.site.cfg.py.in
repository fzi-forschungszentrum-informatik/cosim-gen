@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.circt_tools_dir = lit_config.substitute("@CIRCT_TOOLS_DIR@")
config.cosim_gen_obj_root = "@COSIM_GEN_BINARY_DIR@"
config.cosim_gen_tools_dir = "@LLVM_RUNTIME_OUTPUT_INTDIR@"
config.cosim_gen_libs_dir = "@LLVM_LIBRARY_OUTPUT_INTDIR@"
config.cosim_gen_has_plugin = @COSIM_GEN_HAS_PLUGIN@
config.llvm_shlib_ext = "@SHLIBEXT@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, "@COSIM_GEN_SOURCE_DIR@/test/lit.cfg.py")
