    "CLI": [
      "cosim",
      "cosim-extract",
      "cosim-gen-opt"
    ],
    "API": ["NA"],
    "inputArtifacts": [
      { "artifact": "RTL design", "format": "CIRCT core dialects (.hw.mlir)" },
      { "artifact": "Platform device tree", "format": "DTS" },
      { "artifact": "Co-simulation config", "format": "JSON" }
    ],
    "outputArtifacts": [
      { "artifact": "Per-component co-simulation binary", "format": "ELF" },
      { "artifact": "QEMU device-tree config", "format": "DTS/DTB" }
